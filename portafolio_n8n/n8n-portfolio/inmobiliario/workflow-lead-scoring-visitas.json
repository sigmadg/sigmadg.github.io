{
  "name": "Real Estate - Lead scoring y seguimiento de visitas",
  "nodes": [
    {
      "parameters": {
        "path": "visita-completada",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "i1-webhook",
      "name": "Webhook visita",

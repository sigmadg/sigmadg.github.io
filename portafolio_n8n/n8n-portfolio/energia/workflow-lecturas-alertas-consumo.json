{
  "name": "Energía - Lecturas de medidores y alertas de consumo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      },
      "id": "en1-trigger",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.smartmeters.com/readings",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus(1, 'hour').toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "en2-http",
      "name": "Obtener lecturas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO meter_readings (meter_id, kwh, read_at) VALUES ('{{ $json.meter_id }}', {{ $json.kwh }}, '{{ $json.timestamp }}') ON CONFLICT DO NOTHING"
      },
      "id": "en3-db",
      "name": "Guardar lecturas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst threshold = 1.2;\nconst results = [];\nfor (const item of items) {\n  const kwh = item.json.kwh;\n  const avg = item.json.avg_consumption || kwh;\n  const alert = kwh >= avg * threshold;\n  results.push({ json: { ...item.json, alert, excess_ratio: (kwh/avg).toFixed(2) } });\n}\nreturn results;"
      },
      "id": "en4-code",
      "name": "Evaluar umbral",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.alert }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "en5-if",
      "name": "¿Alerta consumo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#energia-alertas",
        "text": "=Medidor {{ $json.meter_id }}: consumo {{ $json.excess_ratio }}x sobre la media. Revisar."
      },
      "id": "en6-slack",
      "name": "Notificar equipo",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1340,
        200
      ]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Obtener lecturas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener lecturas": {
      "main": [
        [
          {
            "node": "Guardar lecturas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar lecturas": {
      "main": [
        [
          {
            "node": "Evaluar umbral",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluar umbral": {
      "main": [
        [
          {
            "node": "¿Alerta consumo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Alerta consumo?": {
      "main": [
        [
          {
            "node": "Notificar equipo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "versionId": "energia-1"
}
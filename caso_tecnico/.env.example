# =============================================================================
# PLACEHOLDERS ÚNICAMENTE — copiar a .env y reemplazar con tus valores.
# No subas .env al repositorio ni pegues API keys reales en documentación.
# =============================================================================

# Open-Meteo (sin key): reintentos, rate limit 429 y espaciado entre zonas (ver weather_client.py)
# WEATHER_HTTP_RETRIES=5
# WEATHER_HTTP_TIMEOUT_SEC=30
# WEATHER_HTTP_BACKOFF_SEC=0.7
# Tras HTTP 429: espera mínima antes de reintentar (seg); respeta Retry-After si la API lo manda.
# WEATHER_429_MIN_SLEEP_SEC=4
# Pausa entre cada GET por zona (evita ráfagas → 429 con ~14 zonas). 0 = desactivar.
# WEATHER_INTER_ZONE_DELAY_SEC=0.45

# Logging en consola (stderr): DEBUG | INFO | WARNING | ERROR
# OPS_LOG_LEVEL=INFO

# Módulo 2 / 3 — debounce por zona (segundos). Por defecto 2700 = 45 min.
# ALERT_DEBOUNCE_TTL_SEC=2700

# Monitor continuo (modulo3_agente_telegram/monitor_loop.py): segundos entre consultas Open-Meteo
# MONITOR_INTERVAL_SEC=600

# -----------------------------------------------------------------------------
# Excel del caso (hojas RAW_DATA, ZONE_INFO, ZONE_POLYGONS) — motor M2, agente M3, Django, recalibración Docker
# -----------------------------------------------------------------------------
# Ruta al .xlsx: absoluta o relativa a la raíz del repositorio. Si no defines ninguna, se usa
# data/rappi_delivery_case_data.xlsx (ver modulo2_motor_alertas/src/zones.py::default_data_path).
# RAPPI_DATA_PATH=data/rappi_delivery_case_data.xlsx
# Alias equivalente (misma prioridad secundaria si RAPPI_DATA_PATH está vacío):
# CASO_DATA_XLSX=data/rappi_delivery_case_data.xlsx

# Docker (entrypoint): al iniciar el contenedor, regenerar calibration.json desde el Excel anterior (M1).
# 0 = omitir y usar el calibration.json ya incluido en la imagen.
# ENABLE_RECALIBRATE_ON_START=1

# Si otro servicio ya usa 8000 (p. ej. otro contenedor): «Bind for 0.0.0.0:8000 failed».
# Los scripts docker_stack.sh / docker_full_stack.sh eligen 8001 automáticamente si 8000 está ocupado.
# Para fijarlo a mano (o usar 8002, etc.):
# CASO_HOST_HTTP=8001

# docker compose --profile n8n: puerto en el HOST para abrir la UI de n8n en el navegador (evita choque con otro n8n en 5678).
# CASO_HOST_N8N=15678

# Django en Docker: si abres el front por IP de la LAN, amplía hosts (Compose ya trae [::1] y * por defecto en dev).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,[::1],*

# Ping de monitor a Telegram cuando NO hubo alerta completa (solo si TELEGRAM_* está bien).
# 0 = por defecto: solo alertas reales + avisos cortos de debounce si aplica.
# 1 = además mensaje corto de estado (no_alert, error clima, etc.), como máximo cada TELEGRAM_MONITOR_PING_MIN_SEC s.
# Si NO defines TELEGRAM_MONITOR_PING_MIN_SEC, se usa MONITOR_INTERVAL_SEC (evita un solo ping y luego 5 min de silencio).
# TELEGRAM_MONITOR_PING=0
# TELEGRAM_MONITOR_PING_MIN_SEC=300

# -----------------------------------------------------------------------------
# Módulo 3 — Telegram (obligatorio para enviar al canal; ver README sección Telegram)
# -----------------------------------------------------------------------------
# Token del bot (BotFather). Ejemplo ficticio (no es válido):
TELEGRAM_BOT_TOKEN=123456789:AAHeEjemploPlaceholderNoUsar_EsteNoEsUnTokenReal
# Destino: canal @público  o  chat id numérico (p. ej. -1001234567890)
TELEGRAM_CHAT_ID=@tu_canal_o_grupo_demo

# -----------------------------------------------------------------------------
# Módulo 3 — LLM (opcional: sin OpenAI el agente usa plantilla determinista)
# -----------------------------------------------------------------------------
# Proveedor: ollama | openai | auto (auto: OpenAI si hay OPENAI_API_KEY; si no, Ollama)
LLM_PROVIDER=ollama

# --- Ollama (local) — sin API key en .env
# Sin Docker (python en tu máquina): deja OLLAMA_BASE_URL en 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Con la app en Docker, Compose/docker_up inyectan host.docker.internal; NO sustituye esto:
# debes arrancar Ollama en el HOST escuchando en todas las interfaces o verás Connection refused:
#   OLLAMA_HOST=0.0.0.0 ollama serve
#   curl -sS http://127.0.0.1:11434/api/version
# Si ves JSON tipo {"detail":"Invalid token"} al llamar al LLM, OLLAMA_BASE_URL apunta a un servicio
# con auth (no es Ollama): corrige la URL al puerto 11434 de Ollama o quita el proxy equivocado.
OLLAMA_MODEL=mixtral:8x7b-instruct-v0.1-q4_0
# OLLAMA_TIMEOUT_SEC=180
# Tokens de salida / contexto: si el JSON se corta a mitad, sube OLLAMA_NUM_PREDICT (p. ej. 1536).
# OLLAMA_NUM_PREDICT=1024
# OLLAMA_NUM_CTX=8192
# Tras 1.er intento, segunda llamada al modelo solo para reparar JSON (1=activado).
# OLLAMA_JSON_REPAIR_RETRY=1
# OLLAMA_NUM_PREDICT_REPAIR=1536

# --- Docker: la imagen y docker/entrypoint.sh usan host.docker.internal si OLLAMA_BASE_URL es
# 127.0.0.1 o localhost; load_dotenv no sobrescribe variables ya definidas en el contenedor.
# Compose inyecta CASO_OLLAMA_URL (default http://host.docker.internal:11434). En el host:
#   OLLAMA_HOST=0.0.0.0 ollama serve
# Ollama en otro servicio Compose: CASO_OLLAMA_URL=http://nombre_servicio:11434
# Mismo contenedor con Ollama en loopback: OLLAMA_DOCKER_USE_LOOPBACK=1
# CASO_OLLAMA_URL=http://host.docker.internal:11434

# --- OpenAI — solo placeholders; nunca commitear la clave real
# OPENAI_API_KEY=sk-proj-EJEMPLO-PLACEHOLDER-NO-VALIDO
# OPENAI_MODEL=gpt-4o-mini
# USE_LANGCHAIN=1

# No usado por el código actual del caso (reservado si amplías proveedores):
# ANTHROPIC_API_KEY=sk-ant-api03-EJEMPLO-PLACEHOLDER
